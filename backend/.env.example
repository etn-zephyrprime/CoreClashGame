# Copy to backend/.env and fill in real values. Never commit the real .env.

# ---------------- Core / wallet ----------------
BACKEND_PRIVATE_KEY=
ADMIN_ADDRESS=
CORE_TOKEN_ADDRESS=
WETN_TOKEN_ADDRESS=

# ---------------- Data directory ----------------
# Where backend state (games, XP, caches, etc.) lives on disk.
# - Leave unset on Render's paid tier with a disk mounted at /backend/data.
# - Leave unset on the free tier / local dev too — it falls back to
#   ./backend/data automatically. Only set one of these if you want a
#   different location.
# DATA_DIR=
# RENDER_DISK_PATH=

# ---------------- Cloudflare R2 (backend/data backup) ----------------
# Every write under the data directory above is mirrored to this R2 bucket,
# and restored from it on boot — this is what makes state survive restarts
# on Render's free tier, which has no persistent disk.
# Create an R2 API token with Object Read & Write access to the bucket at:
# https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coreclash

# ---------------- Telegram ----------------
TELEGRAM_BOT_TOKEN=
ZEPHYROS_TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
ZEPHYROS_GENERAL_MESSAGE_THREAD_ID=

CLUB_TELEGRAM_BOT_TOKEN=
CLUB_TELEGRAM_CHAT_ID=
CLUB_TELEGRAM_MESSAGE_THREAD_ID=
CLUB_ALL_SWAPS_CHAT_ID=
CLUB_ALL_SWAPS_MESSAGE_THREAD_ID=

# ---------------- Swap-listener tracked tokens ----------------
CLUB_TOKEN_ADDRESS=
BOLT_TOKEN_ADDRESS=
USDT_TOKEN_ADDRESS=
USDC_TOKEN_ADDRESS=
DCNT_TOKEN_ADDRESS=
PDY_TOKEN_ADDRESS=
MEGA_TOKEN_ADDRESS=
DYNO_TOKEN_ADDRESS=
FUGAZI_TOKEN_ADDRESS=

# ---------------- Misc ----------------
# ALL / VKIN / VQLE / SCIONS / EVG — which collection(s) generateMapping.js
# (re)builds when run as a one-off CLI script.
MAPPING_MODE=ALL
