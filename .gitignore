# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# env files — matches .env, backend/.env, etc. at any depth (no leading
# slash). Previously only .env.local/.env.*.local were excluded, which
# left the plain .env committed to git history; see git rm --cached .env.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
